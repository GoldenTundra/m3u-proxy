# Copy to .env and fill in. Only PUBLIC_BASE_URL is required.

# The host's own LAN-reachable address and published port (never localhost or
# a docker-internal hostname) — Channels DVR, Plex, and IPTV players fetch
# stream URLs from this address directly over the network.
PUBLIC_BASE_URL=http://192.168.1.20:9090

# Host port to publish on. If you change it, change PUBLIC_BASE_URL to match.
# HOST_PORT=9090

# Timezone used for guide text such as "Up next: …, 7:00 PM".
# TZ=America/New_York

# Channels DVR: set to your DVR server to refresh its guide automatically
# when you add/remove channels or schedule Live Events.
# CHANNELS_DVR_URL=http://192.168.1.10:8089

# Plex (HDHomeRun emulation). How many channels Plex may watch/record at
# once — each tuned channel runs an ffmpeg process (and, for some sites, a
# headless browser).
# HDHR_TUNER_COUNT=2
# Name shown in Plex's tuner list.
# HDHR_FRIENDLY_NAME=m3u-proxy
# 8 hex characters. Derived from PUBLIC_BASE_URL when unset; set it explicitly
# if you run more than one instance, or want to change PUBLIC_BASE_URL later
# without Plex seeing a "new" tuner.
# HDHR_DEVICE_ID=
